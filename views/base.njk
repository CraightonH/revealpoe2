<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}PoE2 Wiki{% endblock %}</title>
  <!-- Apply the saved card size before first paint to avoid a flash at default size. -->
  <script>
    (function () {
      try {
        var s = localStorage.getItem('cardSize');
        if (s === 's' || s === 'l' || s === 'xl') document.documentElement.setAttribute('data-card-size', s);
      } catch (e) {}
    })();
  </script>
  <link rel="stylesheet" href="/static/fonts.css">
  <link rel="stylesheet" href="/static/css/tokens.css">
  <link rel="stylesheet" href="/static/css/app.css">
  <link rel="stylesheet" href="/static/css/gem-card.css">
  <link rel="stylesheet" href="/static/vendor/tippy.css">
  <script src="/static/vendor/htmx.min.js" defer></script>
  <!-- Popper must load before Tippy (Tippy's UMD build depends on window.Popper). -->
  <script src="/static/vendor/popper.min.js" defer></script>
  <script src="/static/vendor/tippy.umd.min.js" defer></script>
  <!-- Shared tooltip harness must load before the per-feature caller scripts. -->
  <script src="/static/js/tooltips.js" defer></script>
  <script src="/static/js/keywords.js" defer></script>
  <script src="/static/js/gem-tooltip.js" defer></script>
  <script src="/static/js/filter-bar.js" defer></script>
  <script src="/static/js/card-tooltip.js" defer></script>
  <script src="/static/js/card-size.js" defer></script>
  <script src="/static/js/affix-accordion.js" defer></script>
  <script src="/static/js/search-box.js" defer></script>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">PoE2 Wiki</a>
    <div class="search-box">
      <input type="search" name="q" placeholder="Search…"
             hx-get="/search" hx-trigger="input changed delay:200ms, search"
             hx-target="#search-results" autocomplete="off">
      <div id="search-results"></div>
    </div>
    <div class="card-size" role="group" aria-label="Card size">
      <button type="button" data-size="s" title="Small card">S</button>
      <button type="button" data-size="m" title="Medium card">M</button>
      <button type="button" data-size="l" title="Large card">L</button>
      <button type="button" data-size="xl" title="Extra large card">XL</button>
    </div>
  </header>
  <nav class="site-nav" aria-label="Browse">
    <ul class="site-nav__list">
      <li class="site-nav__item">
        <a href="/gems" class="site-nav__top">Gems</a>
        <ul class="site-nav__dropdown">
          <li><a href="/gems">All Skill Gems</a></li>
        </ul>
      </li>
      <li class="site-nav__item">
        <span class="site-nav__top" tabindex="0">Items</span>
        <ul class="site-nav__dropdown">
          <li><a href="/uniques">Unique Items</a></li>
          <li><a href="/bases">Base Items</a></li>
        </ul>
      </li>
      <li class="site-nav__item">
        <span class="site-nav__top" tabindex="0">Passives</span>
        <ul class="site-nav__dropdown">
          <li><a href="/keystones">Keystones</a></li>
          <li><a href="/ascendancies">Ascendancies</a></li>
        </ul>
      </li>
      <li class="site-nav__item">
        <a href="/theorycraft" class="site-nav__top">Theory Crafting</a>
      </li>
    </ul>
  </nav>
  <main>{% block content %}{% endblock %}</main>
</body>
</html>
