{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb %}
{% from "macros/passive.njk" import passiveNodeCard %}
{% block title %}{{ a.name }} — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ breadcrumb([
    { label: 'Ascendancies', href: '/ascendancies' },
    { label: a.charClass },
    { label: a.name }
  ]) }}
  <h1 class="page-title" style="color:var(--color-normal);">
    {{ a.name }}
    <span style="font-size:14px;color:var(--color-default);margin-left:8px;">({{ a.charClass }})</span>
  </h1>
  <div class="passive-node-grid">
    {% for n in a.notables %}
    {{ passiveNodeCard(n, modifier='passive-node-card--asc') }}
    {% endfor %}
  </div>
</div>
{% endblock %}
