{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb %}
{% from "macros/passive.njk" import passiveDetail %}
{% block title %}{{ n.name }} — Reveal · PoE2 Wiki{% endblock %}
{% block content %}
<div class="page">
  {{ breadcrumb([
    { label: 'Passive Tree', href: '/passives' },
    { label: 'Notable' },
    { label: n.name }
  ]) }}
  <div class="gem-detail item-detail" data-item-slug="{{ n.id }}">
    {% if n.hash %}
    <a class="passive-detail-link" href="/passives?node={{ n.hash }}" title="View on Passive Tree">{{ passiveDetail(n) }}</a>
    {% else %}
    {{ passiveDetail(n) }}
    {% endif %}
  </div>
</div>
{% endblock %}
