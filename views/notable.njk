{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb %}
{% from "macros/passive.njk" import passiveDetail %}
{% block title %}{{ n.name }} — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page">
  {{ breadcrumb([
    { label: 'Keystones', href: '/keystones' },
    { label: 'Notable' },
    { label: n.name }
  ]) }}
  <div class="gem-detail">
    {{ passiveDetail(n) }}
  </div>
</div>
{% endblock %}
