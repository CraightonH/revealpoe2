{% extends "base.njk" %}
{% from "macros/gem-card.njk" import gemCard %}
{% from "macros/granted-by.njk" import grantedBy %}
{% from "macros/granted-by-equipping.njk" import grantedByEquipping %}
{% from "macros/recommended-supports.njk" import recommendedSupports %}
{% from "macros/recommended-by.njk" import recommendedBy %}
{% block title %}{{ vm.name }} — Reveal · PoE2 Wiki{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_title %}{{ vm.name }} — Reveal · PoE2 Wiki{% endblock %}
{% block og_desc %}{{ vm.typeLine }}{% if vm.description %} — {{ vm.description | striptags }}{% endif %}{% endblock %}
{% block og_image %}/static/og/gem/{{ vm.slug }}.png{% endblock %}
{% block content %}
<div class="page">
  <div class="gem-detail">
    {{ gemCard(vm) }}
    {{ recommendedSupports(vm) }}
    {{ recommendedBy(vm) }}
    {{ grantedBy(vm) }}
    {{ grantedByEquipping(vm) }}
  </div>
</div>
{% endblock %}
