{% extends "base.njk" %}
{% block title %}Passive Tree — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--passives">
  <div class="passive-tree-wrap" id="tree-wrap">
    <canvas id="tree"></canvas>

    {# Left-docked stat aggregation panel. Populated client-side by the renderer
       (passive-tree.js → passive-stats-agg.js) on every alloc/dealloc; stays
       empty + static-safe with no JS. Collapsible, mirroring #tree-panel. #}
    <div class="tree-panel tree-stats-panel" id="tree-stats-panel">
      <button type="button" class="tree-panel-toggle" id="tree-stats-toggle"
              aria-label="Collapse stats" title="Collapse">‹</button>
      <div class="tree-panel-body">
        <div class="tree-panel-points" id="tree-stats-points">Passive Stats</div>
        <div class="tree-stats-list" id="tree-stats-list">
          <p class="tree-stats-empty">Allocate nodes to see totals.</p>
        </div>
      </div>
    </div>

    {# In-canvas control panel (GGG-style overlay, wiki-native dark styling).
       Existing control ids are preserved so the renderer wiring is unchanged;
       new ids (search / reset / fullscreen / panel toggle) are added below. #}
    <div class="tree-panel" id="tree-panel">
      <button type="button" class="tree-panel-toggle" id="tree-panel-toggle"
              aria-label="Collapse panel" title="Collapse">›</button>
      <div class="tree-panel-body">
        <div class="tree-panel-points" id="tree-points"></div>

        {# Weapon Set: pick a set, then allocate its extra 25-point pool. Default
           (neither active) allocates the shared main tree. Set I paths render
           red, Set II green. #}
        <div class="tree-panel-row tree-panel-ws"
             title="Allocate per-weapon-set passives — pick a set, then click nodes">
          <span class="tree-panel-label">Weapon Set</span>
          <div class="tree-ws-sets" id="tree-ws-sets">
            <button type="button" class="tree-ws-btn" data-ws-set="1">I</button>
            <span class="tree-ws-count" data-ws-count="1">0 / 25</span>
            <button type="button" class="tree-ws-btn" data-ws-set="2">II</button>
            <span class="tree-ws-count" data-ws-count="2">0 / 25</span>
          </div>
        </div>

        <label class="tree-panel-field">
          <span class="tree-panel-label">Character Class</span>
          <select id="tree-class" class="passive-tree-select"></select>
        </label>
        <label class="tree-panel-field">
          <span class="tree-panel-label">Ascendancy</span>
          <select id="tree-ascendancy" class="passive-tree-select"></select>
        </label>
        <label class="tree-panel-field">
          <span class="tree-panel-label">Search</span>
          <input type="search" id="tree-search" class="passive-tree-input"
                 placeholder="Name or stat…" autocomplete="off" spellcheck="false">
        </label>

        <div class="tree-panel-actions">
          <button type="button" id="tree-reset" class="passive-tree-btn">Reset Tree</button>
          <button type="button" id="tree-copy-code" class="passive-tree-btn">Copy Share Code</button>
          <button type="button" id="tree-fullscreen" class="passive-tree-btn">Fullscreen</button>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="module">
  import { load } from '/static/js/passive-tree.js';
  const canvas = document.getElementById('tree');
  if (canvas) load(canvas).catch(console.error);
</script>
{% endblock %}
