<div class="unique-item-with-art">
  <div class="newItemPopup UniquePopup item-popup--poe2"
       style="--card-border: {{ vm.borderColor }}; --card-glow: {{ vm.glowColor }};">
    <div class="itemHeader doubleLine">
      <div class="itemName"><span class="lc unique-name">{{ vm.name }}</span></div>
      <div class="itemName typeLine"><span class="lc unique-type">{{ vm.base }}</span></div>
    </div>
    <div class="content">
      <div class="Stats">
        <div class="property">{{ vm.itemClass }}</div>
        <div class="separator"></div>
        {% for stat in vm.stats %}
        <div class="explicitMod">
          {%- if stat.gemSlug -%}
          {{ stat.prefix }}<a href="/gem/{{ stat.gemSlug }}" data-card-url="/gem/{{ stat.gemSlug }}/card" class="skill-grant-link">{{ stat.skillName }}</a>
          {%- else -%}
          {{ stat.text }}
          {%- endif -%}
        </div>
        {% endfor %}
      </div>
      <div class="separator"></div>
      <div class="default unique-base-line">
        Base item: <a href="/base/{{ vm.baseSlug }}" class="base-link">{{ vm.base }}</a>
      </div>
    </div>
  </div>
  {% if vm.iconUrl %}
  <div class="itemboximage">
    <img loading="lazy" src="{{ vm.iconUrl }}" alt="{{ vm.name }}"
         onerror="this.style.visibility='hidden'">
  </div>
  {% endif %}
</div>
