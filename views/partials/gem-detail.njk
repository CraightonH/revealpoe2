{% from "macros/gem-card.njk" import gemCard %}
{% from "macros/granted-by.njk" import grantedBy %}
{% from "macros/granted-by-equipping.njk" import grantedByEquipping %}
{% from "macros/recommended-supports.njk" import recommendedSupports %}
{% from "macros/recommended-by.njk" import recommendedBy %}
{% from "macros/gem-level-table.njk" import gemLevelTable %}
{% from "macros/item-actions.njk" import itemActionBar %}
<div class="gem-detail item-detail" data-gem-slug="{{ vm.slug }}" data-item-slug="{{ vm.slug }}">
  {{ itemActionBar(vm.name, 'gem', vm.slug, vm.tradeUrl) }}
  {{ gemCard(vm) }}
  {{ gemLevelTable(vm) }}
  {{ recommendedSupports(vm) }}
  {{ recommendedBy(vm) }}
  {{ grantedBy(vm) }}
  {{ grantedByEquipping(vm) }}
</div>
