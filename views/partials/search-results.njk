{% if results.length %}
<div class="search-results">
  {% for r in results %}
  <a href="{{ r.url }}" class="search-result-row">
    <span class="search-result-name">{{ r.name }}</span>
    <span class="search-result-cat search-result-cat--{{ r.category | lower }}">{{ r.category }}</span>
  </a>
  {% endfor %}
</div>
{% endif %}
