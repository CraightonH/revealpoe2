{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb %}
{% from "macros/passive.njk" import passiveDetail %}
{% block title %}{{ k.name }} — Reveal · PoE2 Wiki{% endblock %}
{% block content %}
<div class="page">
  {{ breadcrumb([
    { label: 'Passive Tree', href: '/passives' },
    { label: k.name }
  ]) }}
  <div class="gem-detail item-detail" data-item-slug="{{ k.id }}">
    {{ passiveDetail(k) }}
    {% if k.hash %}<a class="passive-tree-jump" href="/passives?node={{ k.hash }}">View on Passive Tree →</a>{% endif %}
  </div>
</div>
{% endblock %}
