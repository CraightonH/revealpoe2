{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb %}
{% from "macros/passive.njk" import passiveDetail %}
{% block title %}{{ k.name }} — Reveal · PoE2 Wiki{% endblock %}
{% block content %}
<div class="page">
  {{ breadcrumb([
    { label: 'Passive Tree', href: '/passives' },
    { label: k.name }
  ]) }}
  <div class="gem-detail item-detail" data-item-slug="{{ k.id }}">
    {% if k.hash %}
    <a class="passive-detail-link" href="/passives?node={{ k.hash }}" title="View on Passive Tree">{{ passiveDetail(k) }}</a>
    {% else %}
    {{ passiveDetail(k) }}
    {% endif %}
  </div>
</div>
{% endblock %}
