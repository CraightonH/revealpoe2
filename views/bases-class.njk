{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb, pageHeader %}
{% from "macros/filter-bar.njk" import filterBar %}
{% from "macros/affix-tables.njk" import affixTables, affixFlat %}
{% from "macros/base-card.njk" import baseListCard %}
{% from "macros/gem-card.njk" import gemBrowseCard %}
{% block title %}{{ cls.name }} — Base Items — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ breadcrumb([
    { label: 'Base Items', href: '/bases' },
    { label: cls.name }
  ]) }}
  {{ pageHeader(cls.name) }}

  {% if cls.defaultSkillGems.length %}
  <details class="bases-group">
    <summary class="bases-group-title">Default Attack <span class="bases-group-count">{{ cls.defaultSkillGems.length }}</span></summary>
    <p class="bases-top-hint">Equipping any weapon of this class grants this skill by default.</p>
    <div class="gem-browse-grid">
      {% for g in cls.defaultSkillGems %}
      {{ gemBrowseCard(g) }}
      {% endfor %}
    </div>
  </details>
  {% endif %}

  {% if cls.attrSubtypes.length %}
  {{ filterBar(
    groups=[{ key: "attr", match: "any", single: true, active: activeAttr, options: cls.attrSubtypes }],
    target=".bases-list-card, .affix-fam",
    count=".affix-side",
    align="center"
  ) }}
  {% endif %}
  {# "Highest-Tier" is a crafting curation of "All Base Items". When it would list
     every base (classes with no drop-level progression — jewels, charms), the two
     sections are identical, so we drop the redundant tier section and open the
     canonical full list instead. #}
  {% set hasTierCuration = cls.topBases.length and cls.topBases.length < cls.bases.length %}
  <details class="bases-group"{% if not hasTierCuration %} open{% endif %}>
    <summary class="bases-group-title">All Base Items <span class="bases-group-count">{{ cls.bases.length }}</span></summary>
    <div class="bases-list-grid">
      {% for b in cls.bases %}
      {{ baseListCard(b) }}
      {% endfor %}
    </div>
  </details>
  {% if hasTierCuration %}
  <details class="bases-group" open>
    <summary class="bases-group-title">Highest-Tier Bases <span class="bases-group-count">{{ cls.topBases.length }}</span></summary>
    <p class="bases-top-hint">The endgame base of each implicit archetype — what matters once you're crafting.</p>
    <div class="bases-list-grid">
      {% for b in cls.topBases %}
      {{ baseListCard(b) }}
      {% endfor %}
    </div>
  </details>
  {% endif %}
  {% set std = cls.affixes.standard %}
  {% set corr = cls.affixes.corrupted %}
  {% set des = cls.affixes.desecrated %}
  {% if (std.prefix.length or std.suffix.length) or corr.length or (des.prefix.length or des.suffix.length) %}
  <section class="affix-section">
    <h2 class="affix-section-title">Item Affixes</h2>
    <p class="affix-section-hint">Modifiers that can roll on a {{ cls.name }}, grouped by how they're obtained. Click one to see its tiers.</p>

    {% if std.prefix.length or std.suffix.length %}
    <details class="affix-origin" open style="--origin-accent:var(--magic-color)">
      <summary class="affix-origin-title">Standard
        <span class="affix-origin-note">from basic currency (Transmute, Augment, Regal, Exalt&hellip;)</span>
      </summary>
      {{ affixTables(std, '--magic-color') }}
    </details>
    {% endif %}

    {% if des.prefix.length or des.suffix.length %}
    <details class="affix-origin affix-origin--desecrated" open style="--origin-accent:var(--desecrated-color)">
      <summary class="affix-origin-title">Desecrated
        <span class="affix-origin-note">Abyssal modifiers from the Well of Souls (Ulaman, Amanamu, Kurgal)</span>
      </summary>
      {{ affixTables(des, '--desecrated-color') }}
    </details>
    {% endif %}

    {% if corr.length %}
    <details class="affix-origin" open style="--origin-accent:var(--corrupted-color)">
      <summary class="affix-origin-title">Corrupted
        <span class="affix-origin-note">implicit modifiers added by Vaal Orb corruption</span>
      </summary>
      {{ affixFlat('Corrupted', corr, '--corrupted-color') }}
    </details>
    {% endif %}
  </section>
  {% endif %}
</div>
{% endblock %}
