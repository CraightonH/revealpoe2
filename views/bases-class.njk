{% extends "base.njk" %}
{% from "macros/nav.njk" import breadcrumb, pageHeader %}
{% from "macros/affix-tables.njk" import affixTables %}
{% from "macros/base-card.njk" import baseListCard %}
{% block title %}{{ cls.name }} — Base Items — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ breadcrumb([
    { label: 'Base Items', href: '/bases' },
    { label: cls.name }
  ]) }}
  {{ pageHeader(cls.name, cls.bases.length ~ ' base items') }}
  <div class="bases-list-grid">
    {% for b in cls.bases %}
    {{ baseListCard(b) }}
    {% endfor %}
  </div>
  {% if cls.affixes and (cls.affixes.prefix.length or cls.affixes.suffix.length) %}
  <section class="affix-section">
    <h2 class="affix-section-title">Rollable Affixes</h2>
    <p class="affix-section-hint">Modifiers that can roll on any {{ cls.name }}. Click one to see its tiers.</p>
    {{ affixTables(cls.affixes) }}
  </section>
  {% endif %}
</div>
{% endblock %}
