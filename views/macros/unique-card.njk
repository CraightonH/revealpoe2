{% from "macros/card-actions.njk" import tradeLink, tradeButton %}

{% macro modLine(stat) %}
<div class="explicitMod">
  {%- if stat.gemSlug -%}
  {%- if stat.iconUrl %}<img loading="lazy" src="{{ stat.iconUrl }}" class="grantsSkill" alt="" onerror="this.style.display='none'">{% endif -%}
  {{ stat.prefixHtml | safe }}<a href="/gems#{{ stat.gemSlug }}" data-card-url="/gem/{{ stat.gemSlug }}/card" class="skill-grant-link">{{ stat.skillName }}</a>
  {%- else -%}
  {{ stat.html | safe }}
  {%- endif -%}
</div>
{% endmacro %}

{# Like modLine, but for the condensed card (itself an <a>): the granted skill
   stays a <span>, not a nested <a> (which is invalid HTML and spills the card),
   while still carrying data-card-url so the shared card-tooltip delegation shows
   the gem tooltip on hover — same pattern as baseListCard's granted skills. #}
{% macro modLineFlat(stat) %}
<div class="explicitMod">
  {%- if stat.gemSlug -%}
  {%- if stat.iconUrl %}<img loading="lazy" src="{{ stat.iconUrl }}" class="grantsSkill" alt="" onerror="this.style.display='none'">{% endif -%}
  {{ stat.prefixHtml | safe }}<span class="skill-grant-link" data-card-url="/gem/{{ stat.gemSlug }}/card">{{ stat.skillName }}</span>
  {%- else -%}
  {{ stat.html | safe }}
  {%- endif -%}
</div>
{% endmacro %}

{# Condensed card for the /uniques browse grid: same shell as baseListCard with
   the unique-rarity skin (header texture, gold name, amber divider). Full
   tooltip still loads on hover. Icon box tracks the base item's inventory size,
   reusing the shared .bases-list-icon--WxH combo classes. #}
{% macro uniqueListCard(u) %}
{% set sizeClass = ('bases-list-icon--' ~ u.inventorySize.w ~ 'x' ~ u.inventorySize.h) if u.inventorySize else '' %}
<a class="bases-list-card bases-list-card--unique" href="/uniques#{{ u.slug }}" data-card-url="/unique/{{ u.slug }}/card" data-itemclass="{{ u.itemClassSlug }}">
  {{ tradeButton(u.tradeUrl, 'unique', u.slug) }}
  <div class="bases-list-header"><span class="bases-list-name">{{ u.name }}</span></div>
  <div class="bases-list-main">
    {% if u.iconUrl %}
    <img src="{{ u.iconUrl }}" alt="{{ u.name }}" class="bases-list-icon {{ sizeClass }}" loading="lazy"
         onerror="this.style.visibility='hidden'">
    {% else %}
    <div class="bases-list-icon {{ sizeClass }} bases-list-icon--placeholder">{{ u.name[0] }}</div>
    {% endif %}
    <div class="bases-list-body">
      {% if u.properties.length %}
      <div class="bases-list-stats">
        {% for prop in u.properties %}
        <div class="bases-list-stat">{{ prop.labelHtml | safe }}: <span class="{{ prop.colorClass }}">{{ prop.value }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if u.properties.length and (u.requirements.length or u.implicits.length or u.explicits.length) %}<div class="separator"></div>{% endif %}
      {% if u.requirements.length %}<div class="bases-list-req">Requires: {{ u.requirements | join(', ') | safe }}</div>{% endif %}
      {% if u.requirements.length and (u.implicits.length or u.explicits.length) %}<div class="separator"></div>{% endif %}
      {% for s in u.implicits %}{{ modLineFlat(s) }}{% endfor %}
      {% if u.implicits.length and u.explicits.length %}<div class="separator"></div>{% endif %}
      {% for s in u.explicits %}{{ modLineFlat(s) }}{% endfor %}
      {# Pool uniques have no fixed mods, so the grid card would otherwise be
         blank. Summarize the pool instead of listing it — and say "possible" so
         the grid doesn't imply the item carries them all. #}
      {% if u.isPool and u.poolMods.length %}
      <div class="explicitMod bases-list-pool">{{ u.poolLabel }}: <span class="poolMods-count">{{ u.poolMods.length }} possible</span></div>
      {% endif %}
    </div>
  </div>
</a>
{% endmacro %}

{% macro uniqueCard(vm) %}
<div class="unique-item-with-art">
  <div class="newItemPopup UniquePopup item-popup--poe2"
       style="--card-border: {{ vm.borderColor }}; --card-glow: {{ vm.glowColor }};">
    {{ tradeLink(vm.tradeUrl, 'unique', vm.slug) }}
    <div class="itemHeader doubleLine">
      <div class="itemName"><span class="lc unique-name">{{ vm.name }}</span></div>
      <div class="itemName typeLine">{% if vm.baseSlug %}<a class="lc unique-type" href="/bases#{{ vm.classSlug }}" data-card-url="/base/{{ vm.baseSlug }}/card">{{ vm.base }}</a>{% elif vm.baseLabel %}<span class="lc unique-type unique-type--any">{{ vm.baseLabel }}</span>{% else %}<span class="lc unique-type">{{ vm.base }}</span>{% endif %}</div>
    </div>
    <div class="content">
      <div class="Stats">
        <div class="property">{{ vm.className }}{% if vm.origin %} <span class="unique-origin unique-origin--{{ vm.origin | lower }}">{{ vm.origin }}</span>{% endif %}</div>
        {% for prop in vm.properties %}
        <div class="property">{{ prop.labelHtml | safe }}: <span class="{{ prop.colorClass }}">{{ prop.value }}</span></div>
        {% endfor %}
      </div>
      {% if vm.requirements.length %}
      <div class="separator"></div>
      <div class="Stats">
        <div class="requirements">Requires: <span class="colourDefault">{{ vm.requirements | join('</span>, <span class="colourDefault">') | safe }}</span></div>
      </div>
      {% endif %}
      <div class="separator"></div>
      {% if vm.implicits.length %}
      <div class="Stats">
        {% for stat in vm.implicits %}{{ modLine(stat) }}{% endfor %}
      </div>
      {% if vm.explicits.length %}<div class="separator"></div>{% endif %}
      {% endif %}
      {% if vm.explicits.length %}
      <div class="Stats">
        {% for stat in vm.explicits %}{{ modLine(stat) }}{% endfor %}
      </div>
      {% endif %}
      {% if vm.cultivatedMods.length %}
      <div class="separator"></div>
      <div class="Stats cultivatedMods">
        <div class="cultivatedMods-label">Cultivated Mods</div>
        {% for stat in vm.cultivatedMods %}{{ modLine(stat) }}{% endfor %}
      </div>
      {% endif %}
      {# Pool-driven unique (Loreweave & co): mods the item CAN have, not mods it
         does have. The note is load-bearing — the game data records neither how
         many pool mods a finished item gets nor how they're picked, so this block
         must never read like a stat list. Each line links to the unique it was
         woven from where the mod id identifies one. #}
      {% if vm.poolMods.length %}
      {# A pool unique has no implicits/explicits, so the unconditional separator
         above already provides the break — only separate from real mod content. #}
      {% if vm.implicits.length or vm.explicits.length or vm.cultivatedMods.length %}<div class="separator"></div>{% endif %}
      <div class="Stats poolMods">
        <div class="poolMods-label">{{ vm.poolLabel }} <span class="poolMods-count">{{ vm.poolMods.length }} possible</span></div>
        {% for line in vm.poolNote %}<div class="poolMods-note">{{ line | safe }}</div>{% endfor %}
        {% for stat in vm.poolMods %}
        <div class="explicitMod poolMod">
          <span class="poolMod-text">{{ stat.html | safe }}</span>
          {%- if stat.sourceSlug %} <a class="poolMod-source" href="/uniques#{{ stat.sourceSlug }}" data-card-url="/unique/{{ stat.sourceSlug }}/card">{{ stat.sourceUnique }}</a>
          {%- elif stat.sourceUnique %} <span class="poolMod-source">{{ stat.sourceUnique }}</span>{% endif -%}
        </div>
        {% endfor %}
        {% if vm.wideRangeCount %}
        <div class="poolMods-note poolMods-note--aside">{{ vm.wideRangeCount }} of these also exist with wider value ranges in the game data.</div>
        {% endif %}
      </div>
      {% endif %}
      {# Reverse pool_source: this unique's mods feed a pool item's pool. #}
      {% if vm.wovenInto.length %}
      {% if vm.implicits.length or vm.explicits.length or vm.cultivatedMods.length or vm.poolMods.length %}<div class="separator"></div>{% endif %}
      <div class="Stats wovenInto">
        <div class="wovenInto-label">Can be woven into</div>
        {% for w in vm.wovenInto %}
        <div class="explicitMod"><a class="poolMod-source poolMod-source--strong" href="/uniques#{{ w.slug }}" data-card-url="/unique/{{ w.slug }}/card">{{ w.name }}</a></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if vm.flavour.length %}
      <div class="separator"></div>
      <div class="FlavourText">{{ vm.flavour | join('<br>') | safe }}</div>
      {% endif %}
    </div>
  </div>
  {% if vm.iconUrl %}
  <div class="itemboximage">
    <img loading="lazy" src="{{ vm.iconUrl }}" alt="{{ vm.name }}"
         onerror="this.style.visibility='hidden'">
  </div>
  {% endif %}
</div>
{% endmacro %}
