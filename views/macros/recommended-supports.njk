{% from "macros/gem-card.njk" import gemBrowseCard %}
{% macro recommendedSupports(vm) %}
{% if vm.recommendedSupports.length %}
<details class="rec-group" open style="--rec-accent:var(--color-gem)">
  <summary class="rec-group-title">Recommended Supports <span class="rec-group-count">{{ vm.recommendedSupports.length }}</span></summary>
  <p class="rec-group-hint">Support gems suggested for this skill — hover any card for its full tooltip.</p>
  <div class="gem-browse-grid">
    {% for s in vm.recommendedSupports %}
    {{ gemBrowseCard(s) }}
    {% endfor %}
  </div>
</details>
{% endif %}
{% endmacro %}
