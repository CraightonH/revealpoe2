{% macro recommendedSupports(vm) %}
{% if vm.recommendedSupports.length %}
<section class="recommended-supports">
  <h2 class="recommended-supports__title">Recommended Supports</h2>
  <div class="support-list">
    {% for s in vm.recommendedSupports %}
    <a class="{{ s.color }}" href="/gem/{{ s.slug }}">{{ s.name }}</a>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endmacro %}
