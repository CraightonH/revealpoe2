{% from "macros/card-actions.njk" import tradeLink, tradeButton %}

{# A single condensed card for the /gems browse grid. Also reused on the
   /theorycraft results page so gem matches render identically to /gems.
   `modifier` feeds the filter-bar data-type; defaults to the gem's own type. #}
{% macro gemBrowseCard(g, modifier='') %}
{% set dataType = modifier if modifier else g.gemType %}
<a class="gem-browse-card gem-browse-card--{{ g.cardColor }}" href="/gem/{{ g.slug }}"
   data-card-url="/gem/{{ g.slug }}/card"
   data-type="{{ dataType }}"
   data-origin="{{ g.origin }}"
   data-req="{{ g.req | join(' ') }}">
  {{ tradeButton(g.tradeUrl) }}
  <div class="gem-browse-header"><span class="gem-browse-name">{{ g.name }}</span></div>
  <div class="gem-browse-main">
    {% if g.iconUrl %}
    <img class="gem-browse-icon" src="{{ g.iconUrl }}" alt="{{ g.name }}" loading="lazy" onerror="this.style.visibility='hidden'">
    {% endif %}
    <div class="gem-browse-body">
      <div class="gem-browse-tags">{{ g.typeLineHtml | safe }}{% if g.tags.length %} · {{ g.tags | join(', ') | safe }}{% endif %}</div>
      {% if g.requirements.length %}
      <div class="gem-browse-req">Requires: {{ g.requirements | join(', ') | safe }}</div>
      {% endif %}
      {% if g.effect.length %}
      <div class="separator"></div>
      <div class="gem-browse-effect">
        {% for line in g.effect %}<div class="explicitMod">{{ line | safe }}</div>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
</a>
{% endmacro %}

{% macro gemSection(label, gems, modifier='') %}
<section class="gem-list-section">
  <h2 class="gem-list-heading gem-list-heading--{{ modifier }}">{{ label }} (<span data-filter-count>{{ gems.length }}</span>)</h2>
  <div class="gem-browse-grid">
    {% for g in gems %}
    {{ gemBrowseCard(g, modifier) }}
    {% endfor %}
  </div>
</section>
{% endmacro %}

{# Effect sections block (skill effect lines + quality). Shared by the static card and by
   each per-level variant the level selector toggles. #}
{% macro gemSections(sections) %}
{% for section in sections %}
{% if section.label %}
<div class="hybridHeader gemTabs">
  <div class="TextGem TitleBar"><span class="ItemType">{{ section.label }}</span></div>
</div>
{% endif %}
<div class="Stats">
  {% for line in section.lines %}
  <div class="explicitMod">{{ line | safe }}</div>
  {% endfor %}
  {% if section.quality.length or section.altQuality.length %}
  <div class="quality-text"><br><span class="white">Additional Effects From Quality:</span></div>
  {% for q in section.quality %}
  <div class="qualityMod">{{ q | safe }}</div>
  {% endfor %}
  {# Gemling Legionnaire alternate quality — same layout, in-game #b4b4ff colour, no extra label. #}
  {% for q in section.altQuality %}
  <div class="qualityMod altQualityMod">{{ q | safe }}</div>
  {% endfor %}
  {% endif %}
</div>
{% endfor %}
{% endmacro %}

{# opts.static: render a fixed snapshot at the default level (no <select>, no per-level
   variants). Used by the hover-tooltip fragment, where an interactive dropdown is awkward
   and the 40 variant blocks would bloat every tooltip fetch. #}
{% macro gemCard(vm, opts={}) %}
{% set interactive = vm.levelSelect and not opts.static %}
<div class="newItemPopup GemPopup item-popup--poe2{% if vm.borderColor2 %} hybrid-border{% endif %}"
     style="--card-border: {{ vm.borderColor }}; --card-glow: {{ vm.glowColor }};
            {% if vm.borderColor2 %}--card-border-2: {{ vm.borderColor2 }}; --card-glow-2: {{ vm.glowColor2 }};{% endif %}
            {% if vm.hoverImageUrl %}--hover-image: url('{{ vm.hoverImageUrl }}');{% endif %}">
  {{ tradeLink(vm.tradeUrl) }}
  <div class="bg-art"></div>
  <div class="content">
    <div class="itemHeader doubleLine">
      {% if vm.skillIconUrl %}
      <img class="leadSkillIcon" src="{{ vm.skillIconUrl }}"
           onerror="this.style.visibility='hidden'">
      {% endif %}
      {% if vm.gemIconUrl %}
      <img class="trailGemIcon" src="{{ vm.gemIconUrl }}"
           onerror="this.style.visibility='hidden'">
      {% endif %}
      <div class="itemName"><span class="lc">{{ vm.name }}</span></div>
      <div class="itemName typeLine"><span class="lc">{{ vm.typeLineHtml | safe }}</span></div>
    </div>

    <div class="content">
      <div class="Stats">
        {% if vm.tags.length %}
        <div class="property">{{ vm.tags | join(', ') | safe }}</div>
        {% endif %}
        {% if vm.tier %}
        <div class="property">Tier: <span class="colourDefault">{{ vm.tier }}</span></div>
        {% endif %}
        {% if interactive %}
        <div class="property gem-level-line">Level:
          <select class="gem-level-select colourDefault" aria-label="Gem level">
            {% for lvl in vm.levels | reverse %}
            <option value="{{ lvl }}"{% if lvl == vm.level %} selected{% endif %}>{{ lvl }}</option>
            {% endfor %}
          </select>
        </div>
        {% elif vm.levelSelect %}
        <div class="property">Level: <span class="colourDefault">{{ vm.level }}</span></div>
        {% elif vm.levelRange %}
        <div class="property">Level: <span class="colourDefault">({{ vm.levelRange.min }}—{{ vm.levelRange.max }})</span></div>
        {% endif %}
        {% if interactive and vm.hasQuality %}
        {# Quality input: default 0% shows each quality line's (0—N) range; typing a value
           recomputes those lines to the value at that quality (gem-quality-input.js reads
           the embedded series below). #}
        <div class="property gem-quality-line">Quality:
          <input type="text" inputmode="numeric" class="gem-quality-input colourDefault" value="0" aria-label="Gem quality" size="3">%
        </div>
        {% if vm.qualitySeries %}
        <script type="application/json" class="gem-quality-data">{{ vm.qualitySeries | dump | safe }}</script>
        {% endif %}
        {% endif %}
        {% if vm.cost %}
        <div class="property">Cost: {% if interactive %}{% for lvl in vm.levels %}<span class="gem-lv colourDefault" data-level="{{ lvl }}"{% if lvl != vm.level %} hidden{% endif %}>{{ vm.levelData[lvl].cost }}</span>{% endfor %}{% else %}<span class="colourDefault">{{ vm.cost }}</span>{% endif %}</div>
        {% endif %}
        {% if vm.reservation %}
        <div class="property">Reservation: <span class="colourDefault">{{ vm.reservation }}</span></div>
        {% endif %}
        {% if vm.requirements.length %}
        <div class="requirements">Requires: {% if interactive %}{% for lvl in vm.levels %}<span class="gem-lv" data-level="{{ lvl }}"{% if lvl != vm.level %} hidden{% endif %}>{% for r in vm.levelData[lvl].requirements %}<span class="colourDefault">{{ r | safe }}</span>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endfor %}{% else %}{% for r in vm.requirements %}<span class="colourDefault">{{ r | safe }}</span>{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</div>
        {% endif %}
        {% if vm.weaponReq %}
        <div class="requirements">Requires: {{ vm.weaponReq | safe }}</div>
        {% endif %}

        {% if vm.description %}
        <div class="separator"></div>
        <div class="secDescrText">{{ vm.description | safe }}</div>
        {% endif %}
      </div>

      {% if interactive %}
      {% for lvl in vm.levels %}
      <div class="gem-lv" data-level="{{ lvl }}"{% if lvl != vm.level %} hidden{% endif %}>{{ gemSections(vm.levelData[lvl].sections) }}</div>
      {% endfor %}
      {% else %}
      {{ gemSections(vm.sections) }}
      {% endif %}

      {% if vm.footer %}
      <div class="separator"></div>
      <div class="default fst-italic">{{ vm.footer }}</div>
      {% endif %}
    </div>

  </div>
</div>
{% endmacro %}
