{% from "macros/gem-card.njk" import gemBrowseCard %}
{% macro recommendedBy(vm, collapseAt=12) %}
{% if vm.recommendedBy.length %}
<details class="rec-group" open style="--rec-accent:var(--color-prop)">
  <summary class="rec-group-title">Recommended For <span class="rec-group-count">{{ vm.recommendedBy.length }}</span></summary>
  <p class="rec-group-hint">Skills that recommend this support gem.</p>
  <div class="gem-browse-grid">
    {% for s in vm.recommendedBy.slice(0, collapseAt) %}
    {{ gemBrowseCard(s) }}
    {% endfor %}
  </div>
  {% if vm.recommendedBy.length > collapseAt %}
  <details class="support-more">
    <summary class="support-more__toggle">+{{ vm.recommendedBy.length - collapseAt }} more</summary>
    <div class="gem-browse-grid support-more__list">
      {% for s in vm.recommendedBy.slice(collapseAt) %}
      {{ gemBrowseCard(s) }}
      {% endfor %}
    </div>
  </details>
  {% endif %}
</details>
{% endif %}
{% endmacro %}
