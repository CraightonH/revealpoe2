{# Two-column rollable-affix browser for a base item. Each family is a tbody whose
   first row is the top tier (T1, always shown); clicking reveals the lower tiers
   (T2..Tn) inline in the same column grid (see affix-accordion.js). #}

{% macro _affixSide(title, families, accentVar) %}
<section class="affix-side">
  <h2 class="affix-side-title" style="color:var({{ accentVar }})">{{ title }} <span class="affix-side-count" data-filter-count>{{ families.length }}</span></h2>
  {% if families.length %}
  <table class="affix-table">
    <thead>
      <tr>
        <th class="affix-col-tier">Tier</th>
        <th class="affix-col-mod">Modifier</th>
        <th class="affix-col-num">iLvl</th>
      </tr>
    </thead>
    {% for f in families %}
    {% set tiers = f.tiers | reverse %}
    {% set top = tiers[0] %}
    {% set more = tiers.length - 1 %}
    <tbody class="affix-fam"{% if f.attrs and f.attrs.length %} data-attr="{{ f.attrs | join(' ') }}"{% endif %}>
      <tr class="affix-row" tabindex="0" role="button" aria-expanded="false"
          aria-label="{% if more %}Show {{ more }} lower tier{{ 's' if more != 1 }} for {{ f.displayName }}{% else %}{{ f.displayName }} (single tier){% endif %}">
        <td class="affix-col-tier">
          <span class="affix-caret{% if not more %} affix-caret--empty{% endif %}" aria-hidden="true">▸</span>
          <span class="affix-tbadge">T1</span>
        </td>
        <td class="affix-col-mod">
          <span class="affix-text">{{ top.html | safe }}</span>
          <span class="affix-tag-list">
            {%- for tag in f.tags %}<span class="affix-tag affix-tag--{{ tag }}">{{ tag | replace('_', ' ') }}</span>{% endfor -%}
            {%- if more %}<span class="affix-more">+{{ more }} tier{{ 's' if more != 1 }}</span>{% endif -%}
            <span class="affix-tname">{{ top.name }}</span>
          </span>
        </td>
        <td class="affix-col-num">{{ top.level }}</td>
      </tr>
      {% for t in tiers %}
      {% if not loop.first %}
      <tr class="affix-tier-row" hidden>
        <td class="affix-col-tier"><span class="affix-tbadge affix-tbadge--lower">T{{ loop.index }}</span></td>
        <td class="affix-col-mod">
          <span class="affix-text">{{ t.html | safe }}</span>
          <span class="affix-tname">{{ t.name }}</span>
        </td>
        <td class="affix-col-num">{{ t.level }}</td>
      </tr>
      {% endif %}
      {% endfor %}
    </tbody>
    {% endfor %}
  </table>
  {% else %}
  <p class="affix-empty">No {{ title | lower }} roll on this base.</p>
  {% endif %}
</section>
{% endmacro %}

{% macro affixTables(affixes, accentVar='--magic-color') %}
<div class="affix-tables">
  {{ _affixSide('Prefix', affixes.prefix, accentVar) }}
  {{ _affixSide('Suffix', affixes.suffix, accentVar) }}
</div>
{% endmacro %}

{# Single full-width table — for origins with no prefix/suffix split (e.g. Vaal
   corruption mods, which are applied directly as implicits). #}
{% macro affixFlat(title, families, accentVar='--magic-color') %}
<div class="affix-tables affix-tables--single">
  {{ _affixSide(title, families, accentVar) }}
</div>
{% endmacro %}

{# Full "Item Affixes" section: the three affix origins (Standard / Desecrated /
   Corrupted) as collapsible groups. Shared by the class page (/bases/:class) and
   the per-base page (/base/:slug). `subject` is the phrase after "roll on" in the
   hint, e.g. "a Jewel" or "a Ruby". #}
{% macro affixSection(affixes, subject) %}
{% set std = affixes.standard %}
{% set corr = affixes.corrupted %}
{% set des = affixes.desecrated %}
{% if (std.prefix.length or std.suffix.length) or corr.length or (des.prefix.length or des.suffix.length) %}
<section class="affix-section">
  <h2 class="affix-section-title">Item Affixes</h2>
  <p class="affix-section-hint">Modifiers that can roll on {{ subject }}, grouped by how they're obtained. Click one to see its tiers.</p>

  {% if std.prefix.length or std.suffix.length %}
  <details class="affix-origin" open style="--origin-accent:var(--magic-color)">
    <summary class="affix-origin-title">Standard
      <span class="affix-origin-note">from basic currency (Transmute, Augment, Regal, Exalt&hellip;)</span>
    </summary>
    {{ affixTables(std, '--magic-color') }}
  </details>
  {% endif %}

  {% if des.prefix.length or des.suffix.length %}
  <details class="affix-origin affix-origin--desecrated" open style="--origin-accent:var(--desecrated-color)">
    <summary class="affix-origin-title">Desecrated
      <span class="affix-origin-note">Abyssal modifiers from the Well of Souls (Ulaman, Amanamu, Kurgal)</span>
    </summary>
    {{ affixTables(des, '--desecrated-color') }}
  </details>
  {% endif %}

  {% if corr.length %}
  <details class="affix-origin" open style="--origin-accent:var(--corrupted-color)">
    <summary class="affix-origin-title">Corrupted
      <span class="affix-origin-note">implicit modifiers added by Vaal Orb corruption</span>
    </summary>
    {{ affixFlat('Corrupted', corr, '--corrupted-color') }}
  </details>
  {% endif %}
</section>
{% endif %}
{% endmacro %}
