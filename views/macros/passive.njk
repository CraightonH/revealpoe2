{# A single condensed passive node card for the /keystones index grid. Also
   reused on /theorycraft for keystone/notable matches. `urlBase` selects the
   detail/card route ('keystone' or 'notable'); full tooltip loads on hover. #}
{% macro passiveBrowseCard(node, urlBase='keystone', variant='') %}
<a class="keystone-index-card{% if variant %} {{ variant }}-card{% endif %}" href="/{{ urlBase }}/{{ node.id }}" data-card-url="/{{ urlBase }}/{{ node.id }}/card">
  <div class="keystone-index-header"><span class="keystone-index-name">{{ node.name }}</span></div>
  <div class="keystone-index-main">
    {% if node.iconUrl %}
    <img src="{{ node.iconUrl }}" alt="{{ node.name }}" class="keystone-index-icon" loading="lazy"
         onerror="this.style.visibility='hidden'">
    {% else %}
    <div class="keystone-index-icon keystone-index-placeholder{% if variant %} {{ variant }}-placeholder{% endif %}">{{ node.name[0] }}</div>
    {% endif %}
    <div class="keystone-index-body">
      {% if node.grantedSkill %}
      <div class="explicitMod">
        {%- if node.grantedSkill.iconUrl %}<img loading="lazy" src="{{ node.grantedSkill.iconUrl }}" class="grantsSkill" alt="" onerror="this.style.display='none'">{% endif -%}
        Grants Skill: <span class="skill-grant-link">{{ node.grantedSkill.name }}</span>
      </div>
      {% endif %}
      {% for line in node.statLines %}<div class="explicitMod">{{ line | safe }}</div>{% endfor %}
    </div>
  </div>
</a>
{% endmacro %}

{% macro passiveDetail(node) %}
{% if node.ascColor %}
<div class="newItemPopup PassivePopup item-popup--poe2 is-asc" style="--card-border: {{ node.ascColor }}; --card-glow: color-mix(in srgb, {{ node.ascColor }} 45%, transparent); --passive-name-color: {{ node.ascColor }};">
{% else %}
<div class="newItemPopup PassivePopup item-popup--poe2 is-{{ node.kind }}" style="--card-border: var(--color-{{ node.kind }}); --card-glow: var(--color-{{ node.kind }}-glow);">
{% endif %}
  <div class="itemHeader doubleLine passiveHeader">
    <div class="itemName"><span class="lc">{{ node.name }}</span></div>
    <div class="itemName typeLine"><span class="lc">{% if node.ascendancyName %}{{ node.ascendancyName }}{% elif node.typeLabel %}{{ node.typeLabel }}{% elif node.kind == 'keystone' %}Keystone{% else %}Notable Passive{% endif %}</span></div>
  </div>
  <div class="content">
    {% if node.grantedSkill %}
    <div class="Stats">
      <div class="explicitMod">
        {%- if node.grantedSkill.iconUrl %}<img loading="lazy" src="{{ node.grantedSkill.iconUrl }}" class="grantsSkill" alt="" onerror="this.style.display='none'">{% endif -%}
        Grants Skill: <a href="/gem/{{ node.grantedSkill.slug }}" data-card-url="/gem/{{ node.grantedSkill.slug }}/card" class="skill-grant-link">{{ node.grantedSkill.name }}</a>
      </div>
    </div>
    {% endif %}
    {% if node.attrOptions %}
    {# Generic-attribute node: resting state shows the generic "+5 to any
       Attribute" line; clicking the node reveals the Str/Int/Dex picker
       (.attr-choice, hidden until then); once picked it collapses to the chosen
       line. Visibility is toggled by paintAttrChoice() in passive-tree.js. #}
    <div class="Stats attr-generic">
      {% for line in node.statLines %}
      <div class="explicitMod">{{ line | safe }}</div>
      {% endfor %}
    </div>
    <div class="Stats attr-choice" hidden>
      {% for opt in node.attrOptions %}
      <div class="explicitMod attr-opt" data-attr="{{ opt.key }}">{{ opt.line | safe }}</div>
      {% endfor %}
    </div>
    {% elif node.statLines.length %}
    <div class="Stats">
      {% for line in node.statLines %}
      <div class="explicitMod">{{ line | safe }}</div>
      {% endfor %}
    </div>
    {% endif %}
    {% if node.reminderText.length %}
    <div class="Stats">
      {% for line in node.reminderText %}
      <div class="reminderText">{{ line | safe }}</div>
      {% endfor %}
    </div>
    {% endif %}
    {% if node.flavourText %}
    <div class="separator"></div>
    <div class="FlavourText">{{ node.flavourText }}</div>
    {% endif %}
    {% if node.instill %}
    {# Instill recipe: the 3 Distilled Emotions that craft the Instilling Orb
       granting this Notable. Centered boxes, icon over name; each box is a
       nested tooltip (data-card-url) resolving the emotion's detail card. #}
    <div class="separator"></div>
    <div class="instillRecipe" aria-label="Instill recipe">
      {% for e in node.instill %}
      <div class="instill-emotion instill-emotion--{{ e.key }}" data-card-url="/api/emotion/{{ e.key }}/card">
        {% if e.iconUrl %}
        <img src="{{ e.iconUrl }}" alt="{{ e.name }}" class="instill-emotion__icon" loading="lazy" onerror="this.style.visibility='hidden'">
        {% else %}
        <div class="instill-emotion__icon instill-emotion__placeholder">{{ e.name[0] }}</div>
        {% endif %}
        <div class="instill-emotion__name">{{ e.name }}</div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</div>
{% endmacro %}
