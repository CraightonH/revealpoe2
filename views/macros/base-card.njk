{# Compact class nav card used on the /bases index grid (and reused wherever we
   want to point at a whole item class rather than list every base): name, icon,
   base count, links to /bases/:classSlug. #}
{% macro basesClassCard(c) %}
<a class="bases-class-card" href="{{ c.href }}"
   title="{{ c.name }}" aria-label="{{ c.name }} ({{ c.count }} bases)">
  <span class="bases-class-name">{{ c.name }}</span>
  {% if c.iconUrl %}
  <img class="bases-class-icon" src="{{ c.iconUrl }}" alt="" loading="lazy" onerror="this.remove()">
  {% endif %}
  <span class="bases-class-count">{{ c.count }}</span>
</a>
{% endmacro %}

{# Condensed card for the /bases/:class grid: one key stat per line with the
   same keyword-linked labels unique cards use; full tooltip on hover. #}
{% macro baseListCard(b) %}
<a class="bases-list-card" href="/base/{{ b.slug }}" data-card-url="/base/{{ b.slug }}/card"{% if b.attr %} data-attr="{{ b.attr }}"{% endif %}>
  <div class="bases-list-header"><span class="bases-list-name">{{ b.name }}</span></div>
  <div class="bases-list-main">
    {% set sizeClass = 'bases-list-icon--' ~ b.inventorySize.w ~ 'x' ~ b.inventorySize.h %}
    {% if b.iconUrl %}
    <img src="{{ b.iconUrl }}" alt="{{ b.name }}" class="bases-list-icon {{ sizeClass }}" loading="lazy"
         onerror="this.style.visibility='hidden'">
    {% else %}
    <div class="bases-list-icon bases-list-icon--placeholder {{ sizeClass }}">{{ b.name[0] }}</div>
    {% endif %}
    <div class="bases-list-body">
      {% if b.properties.length %}
      <div class="bases-list-stats">
        {% for prop in b.properties %}
        <div class="bases-list-stat">{{ prop.labelHtml | safe }}: <span class="v">{{ prop.value }}</span></div>
        {% endfor %}
      </div>
      {% endif %}
      {% if b.properties.length and b.requirements.length %}
      <div class="separator"></div>
      {% endif %}
      {% if b.requirements.length %}
      <div class="bases-list-req">Requires: {{ b.requirements | join(', ') | safe }}</div>
      {% endif %}
      {% if b.implicits.length %}
      <div class="bases-list-impl">{% for imp in b.implicits %}{{ imp.html | safe }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
      {% endif %}
      {% if b.grantedSkills.length %}
      <div class="bases-list-impl">{% for s in b.grantedSkills %}Grants Skill: <span class="skill-grant-link" data-card-url="/gem/{{ s.slug }}/card">{{ s.name }}</span>{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
      {% endif %}
    </div>
  </div>
</a>
{% endmacro %}

{% macro baseCard(vm, full=false) %}
<div class="unique-item-with-art">
  <div class="newItemPopup NormalPopup item-popup--poe2">
    <div class="itemHeader doubleLine">
      <div class="itemName"><span class="lc normal-name">{{ vm.name }}</span></div>
      <div class="itemName typeLine"><span class="lc normal-type">{{ vm.className }}</span></div>
    </div>
    <div class="content">
      {% if vm.properties.length %}
      <div class="Stats">
        {% for prop in vm.properties %}
        <div class="property">{{ prop.label }}: <span class="{{ prop.colorClass if prop.colorClass else 'colourDefault' }}">{{ prop.value }}</span></div>
        {% endfor %}
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if vm.requirements.length %}
      <div class="Stats">
        <div class="requirements">Requires: <span class="colourDefault">{{ vm.requirements | join('</span>, <span class="colourDefault">') | safe }}</span></div>
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if vm.implicits.length %}
      <div class="Stats">
        {% for imp in vm.implicits %}
        <div class="explicitMod">{{ imp.html | safe }}</div>
        {% endfor %}
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if vm.grantedSkills.length %}
      <div class="Stats">
        {% for s in vm.grantedSkills %}
        <div class="explicitMod">
          {%- if s.iconUrl %}<img loading="lazy" src="{{ s.iconUrl }}" class="grantsSkill" alt="" onerror="this.style.display='none'">{% endif -%}
          Grants Skill: <a href="/gem/{{ s.slug }}" data-card-url="/gem/{{ s.slug }}/card" class="skill-grant-link">{{ s.name }}</a>
        </div>
        {% endfor %}
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if full and vm.tags.length %}
      <div class="Stats">
        <div class="default fst-italic">Tags: {{ vm.tags | join(', ') }}</div>
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if vm.runeVariants.length %}
      <div class="Stats">
        <div class="property" style="margin-bottom:4px;">Runeforged variants:</div>
        {% for rv in vm.runeVariants %}
        <div class="property" style="padding-left:8px;">{{ rv.name }}</div>
        {% for opt in rv.options %}
        <div class="explicitMod" style="padding-left:16px;">{% for imp in opt %}{{ imp.html | safe }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>
        {% endfor %}
        {% endfor %}
      </div>
      <div class="separator"></div>
      {% endif %}
      {% if vm.uniquesOnBase.length %}
      <div class="Stats">
        <div class="property" style="margin-bottom:4px;">Unique versions:</div>
        {% for u in vm.uniquesOnBase %}
        <div class="property" style="padding-left:8px;">
          <a href="/unique/{{ u.slug }}" data-card-url="/unique/{{ u.slug }}/card" style="color:var(--unique-color);text-decoration:none;">
            {% if u.iconUrl %}
            <img src="{{ u.iconUrl }}" alt="{{ u.name }}"
                 style="width:16px;height:16px;vertical-align:middle;margin-right:4px;object-fit:contain;"
                 onerror="this.style.visibility='hidden'">
            {% endif %}
            {{ u.name }}
          </a>
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% if vm.iconUrl %}
  <div class="itemboximage">
    <img loading="lazy" src="{{ vm.iconUrl }}" alt="{{ vm.name }}"
         onerror="this.style.visibility='hidden'">
  </div>
  {% endif %}
</div>
{% endmacro %}
