{% extends "base.njk" %}
{% from "macros/nav.njk" import pageHeader %}
{% from "macros/passive.njk" import passiveNodeCard %}
{% block title %}Keystones — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ pageHeader('Keystones', keystones.length ~ ' keystones') }}
  <div class="passive-node-grid">
    {% for k in keystones %}
    {{ passiveNodeCard(k, href='/keystone/' + k.id) }}
    {% endfor %}
  </div>
</div>
{% endblock %}
