{% extends "base.njk" %}
{% from "macros/filter-bar.njk" import filterBar %}
{% from "macros/gem-card.njk" import gemSection %}
{% from "macros/nav.njk" import pageHeader %}
{% block title %}Skill Gems — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ pageHeader('Skill Gems', (active.length + support.length + spirit.length) ~ ' gems', '--color-gem') }}

  {{ filterBar(
    groups=[{
      key: "type",
      label: "Type",
      match: "any",
      options: [
        { value: "active", label: "Active" },
        { value: "spirit", label: "Spirit" },
        { value: "support", label: "Support" }
      ]
    }, {
      key: "origin",
      label: "Origin",
      match: "any",
      options: [
        { value: "gem", label: "Gem", default: true },
        { value: "item", label: "Item" },
        { value: "other", label: "Other" }
      ]
    }, {
      key: "req",
      label: "Requires",
      options: [
        { value: "str", label: "Str", color: "r" },
        { value: "dex", label: "Dex", color: "g" },
        { value: "int", label: "Int", color: "b" }
      ]
    }],
    target=".gem-browse-card",
    section=".gem-list-section"
  ) }}

  {{ gemSection('Active Skills', active, 'active') }}
  {{ gemSection('Spirit Skills', spirit, 'spirit') }}
  {{ gemSection('Support Gems', support, 'support') }}
</div>
{% endblock %}
