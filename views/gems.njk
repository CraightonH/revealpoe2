{% extends "base.njk" %}
{% from "macros/filter-bar.njk" import filterBar %}
{% block title %}Skill Gems — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page" style="flex-direction:column;align-items:center;">
  <h1 class="page-title" style="font-family:'OptimusPrincepsSemiBold',serif;color:var(--color-gem);">
    Skill Gems
  </h1>
  <p class="page-subtitle">{{ active.length + support.length + spirit.length }} gems</p>

  {{ filterBar(
    groups=[{
      key: "req",
      label: "Requires",
      options: [
        { value: "str", label: "Str", color: "r" },
        { value: "dex", label: "Dex", color: "g" },
        { value: "int", label: "Int", color: "b" }
      ]
    }],
    target=".gem-browse-card",
    section=".gem-list-section"
  ) }}

  <section class="gem-list-section">
    <h2 class="gem-list-heading gem-list-heading--active">Active Skills ({{ active.length }})</h2>
    <div class="gem-browse-grid">
      {% for g in active %}
      <a class="gem-browse-card gem-browse-card--{{ g.cardColor }}" href="/gem/{{ g.slug }}"
         data-req="{{ g.req | join(' ') }}">
        {% if g.iconUrl %}
        <img class="gem-browse-icon" src="{{ g.iconUrl }}" alt="{{ g.name }}" onerror="this.style.visibility='hidden'">
        {% endif %}
        <span class="gem-browse-name">{{ g.name }}</span>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="gem-list-section">
    <h2 class="gem-list-heading gem-list-heading--spirit">Spirit Skills ({{ spirit.length }})</h2>
    <div class="gem-browse-grid">
      {% for g in spirit %}
      <a class="gem-browse-card gem-browse-card--{{ g.cardColor }}" href="/gem/{{ g.slug }}"
         data-req="{{ g.req | join(' ') }}">
        {% if g.iconUrl %}
        <img class="gem-browse-icon" src="{{ g.iconUrl }}" alt="{{ g.name }}" onerror="this.style.visibility='hidden'">
        {% endif %}
        <span class="gem-browse-name">{{ g.name }}</span>
      </a>
      {% endfor %}
    </div>
  </section>

  <section class="gem-list-section">
    <h2 class="gem-list-heading gem-list-heading--support">Support Gems ({{ support.length }})</h2>
    <div class="gem-browse-grid">
      {% for g in support %}
      <a class="gem-browse-card gem-browse-card--{{ g.cardColor }}" href="/gem/{{ g.slug }}"
         data-req="{{ g.req | join(' ') }}">
        {% if g.iconUrl %}
        <img class="gem-browse-icon" src="{{ g.iconUrl }}" alt="{{ g.name }}" onerror="this.style.visibility='hidden'">
        {% endif %}
        <span class="gem-browse-name">{{ g.name }}</span>
      </a>
      {% endfor %}
    </div>
  </section>
</div>
{% endblock %}
