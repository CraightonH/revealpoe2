{% extends "base.njk" %}
{% from "macros/base-card.njk" import baseCard %}
{% from "macros/nav.njk" import breadcrumb %}
{% block title %}{{ vm.name }} — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page">
  <div class="gem-detail">
    {{ breadcrumb([
      { label: 'Base Items', href: '/bases' },
      { label: vm.className, href: '/bases/' + vm.classSlug },
      { label: vm.name }
    ]) }}
    {{ baseCard(vm, full=true) }}
  </div>
</div>
{% endblock %}
