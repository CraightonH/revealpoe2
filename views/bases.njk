{% extends "base.njk" %}
{% from "macros/nav.njk" import pageHeader %}
{% block title %}Base Items — PoE2 Wiki{% endblock %}
{% block content %}
<div class="page page--column">
  {{ pageHeader('Base Items', 'Browse item bases by class') }}
  {% for group in groups %}
  <details class="bases-group" open>
    <summary class="bases-group-title">{{ group.label }}</summary>
    {% for section in group.sections %}
    {% if section.cards.length %}
    {% if section.title %}<h3 class="bases-subgroup-title">{{ section.title }}</h3>{% endif %}
    <div class="bases-class-grid">
      {% for c in section.cards %}
      <a class="bases-class-card" href="{{ c.href }}"
         title="{{ c.name }}" aria-label="{{ c.name }} ({{ c.count }} bases)">
        <span class="bases-class-name">{{ c.name }}</span>
        {% if c.iconUrl %}
        <img class="bases-class-icon" src="{{ c.iconUrl }}" alt="" loading="lazy" onerror="this.remove()">
        {% endif %}
        <span class="bases-class-count">{{ c.count }}</span>
      </a>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
  </details>
  {% endfor %}
</div>
{% endblock %}
