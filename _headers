# Cloudflare Pages headers. Read only from the deploy root (dist/_headers);
# scripts/prerender.js copies this file there. Path patterns match deployed URLs.

# ── Security hardening (applies site-wide) ────────────────────────────────────
# This is a fully static, self-hosted site: no server, no cookies, no auth, no
# runtime third-party CDN (htmx/popper/tippy are vendored under /static/vendor;
# game art + fonts are self-hosted). So we can lock every fetch directive to
# 'self'. The CSP still allows 'unsafe-inline' for scripts/styles because the
# templates use inline event handlers (onerror icon fallback), one inline
# <script> in base.njk, and ~20 inline style= attrs; a nonce-based strict CSP
# would require refactoring those first. Even with 'unsafe-inline', locking the
# *sources* to 'self' blocks injection of any external script/connect/frame
# endpoint — the high-value protection against XSS exfiltration and supply-chain
# script injection. frame-ancestors 'none' + X-Frame-Options block clickjacking.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Self-hosted game art (/static/img/*). Paths are NOT content-hashed — the image
# fetcher updates art in place (same filename) when ggpk's ETag changes on a
# re-scrape — so we must NOT mark these immutable. A day of browser caching with
# a week of background revalidation eliminates the per-icon revalidation roundtrip
# Cloudflare Pages otherwise forces (its default is max-age=0, must-revalidate),
# while the strong ETag still guarantees correctness once the TTL lapses.
/static/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Fonts effectively never change; cache them hard for a year.
/static/fonts/*
  Cache-Control: public, max-age=31536000
