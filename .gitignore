.env
node_modules/
.DS_Store
dist/
.cache/
.wrangler/
.superpowers/
build/
# Generated client artifacts (search index + browse-card HTML), built from the
# graph by scripts/build-index.js. Regenerable; not committed.
public/generated/
# Self-hosted game art, mirrored from ggpk.exposed by scripts/fetch-images.js.
# Large (~80M) and regenerable; not committed.
public/img/
# OG preview-card PNGs, rendered from the graph by scripts/build-og.js.
# Regenerable; not committed.
public/og/
# Scraped game data — large, regenerable via scripts/scrape.py. Not committed.
# (data/manual/ IS committed — hand-authored overlays.)
# EXCEPTION: per-folder CLAUDE.md files ARE committed so the "how to regenerate
# this data" guide ships on a fresh clone (when the folders are otherwise empty)
# and auto-loads when you work in that folder.
data/source/**
!data/source/**/
!data/source/**/CLAUDE.md
